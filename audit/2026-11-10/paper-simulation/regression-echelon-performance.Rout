> check("echelon analytic gradient includes the lag-zero factor",{
+   set.seed(144);Y<-matrix(rnorm(400),200,2)
+   pattern<-internal(".varma_echelon_pattern")(c(2L,1L),TRUE)
+   par<-runif(nrow(pattern),-.04,.04);par[pattern[,1]==1L]<-.25
+   eval<-function(x,grad=TRUE) internal("echelon_css_cpp")(Y,x,pattern,2L,grad)
+   z<-eval(par);stopifnot(z$valid)
+   numerical<-numeric(length(par));h<-1e-6
+   for(j in seq_along(par)) {
+     up<-down<-par;up[j]<-up[j]+h;down[j]<-down[j]-h
+     numerical[j]<-(eval(up,FALSE)$value-eval(down,FALSE)$value)/(2*h)
+   }
+   close(z$gradient,numerical,1e-6)
+   f<-varma(intercept=as.numeric(z$intercept),ar=z$ar,ma=z$ma)
+   E<-residuals(f,Y=Y)
+   close(z$value,-internal(".varma_gaussian_ll")(E[-(1:2),,drop=FALSE],z$cov))
+ })
PASS: echelon analytic gradient includes the lag-zero factor 
