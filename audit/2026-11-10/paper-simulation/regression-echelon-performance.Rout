> check("supplied echelon indices, mean, zero indices, forecasts, and bootstrap",{
+   set.seed(299)
+   Phi0<-matrix(c(1,.3,0,1),2)
+   A<-solve(Phi0,matrix(c(.5,0,0,0),2))
+   B<-solve(Phi0,matrix(c(.2,0,.15,0),2))
+   truth<-varma(ar=array(A,c(2,2,1)),ma=array(B,c(2,2,1)),mean=c(2,-1),cov=diag(2))
+   Y<-sim_varma(truth,600)
+   f<-fit_varma_echelon(Y,c(1,0),control=list(maxit=500,reltol=1e-9))
+   stopifnot(identical(as.integer(f$kronecker_indices),c(1L,0L)),!f$indices_estimated,
+             f$convergence==0L,all(is_stable(f)),f$npar==length(f$coefficients)+3)
+   for(lag in seq_len(dim(f$ar)[3])) {
+     close(f$echelon$Phi0%*%f$ar[,,lag],f$echelon$ar[,,lag])
+     close(f$echelon$Phi0%*%f$ma[,,lag],f$echelon$ma[,,lag])
+   }
+   close(f$echelon$Phi0%*%f$intercept,f$echelon$intercept)
+   close(f$residuals,residuals(f));close(f$optim.out$value,-as.numeric(logLik(f)))
+   stopifnot(identical(dim(predict(f,3)$cov),c(2L,2L,3L)))
+   stopifnot(irf_distance(irf(f,5),irf(truth,5))<.2)
+   white<-fit_varma_echelon(Y,c(0,0))
+   close(white$intercept,colMeans(Y));close(predict(white,2,cov=FALSE),matrix(rep(colMeans(Y),each=2),2))
+   no_mean<-fit_varma_echelon(Y,c(0,0),intercept=FALSE)
+   close(no_mean$cov,crossprod(Y)/nrow(Y))
+   uni<-fit_varma_echelon(Y[,1,drop=FALSE],1L,control=list(maxit=500))
+   stopifnot(identical(dim(predict(uni,1)$cov),c(1L,1L,1L)))
+   boots<-bootstrap_varma(white,nsim=2)
+   stopifnot(all(vapply(boots,function(x) identical(x$kronecker_indices,white$kronecker_indices),logical(1))))
+   fails(fit_varma_echelon(Y,c(1,.5)));fails(fit_varma_echelon(Y,1L))
+ })
PASS: supplied echelon indices, mean, zero indices, forecasts, and bootstrap 
