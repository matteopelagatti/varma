+               identical(fit$selection$method,"varma::select_kronecker_indices"))
+     refit<-bootstrap_varma(fit,nsim=1,kidx=NULL)[[1]]
+     stopifnot(refit$indices_estimated)
+     set.seed(332)
+     truth<-varma(ar=array(diag(c(.65,.5)),c(2,2,1)),
+                   ma=array(diag(c(.2,.1)),c(2,2,1)),cov=diag(2))
+     dynamic<-fit_varma_echelon(sim_varma(truth,1000),control=list(maxit=500))
+     stopifnot(dynamic$convergence==0L,all(dynamic$kronecker_indices>0L),
+               irf_distance(irf(truth,5),irf(dynamic,5))<.15)
+ })
