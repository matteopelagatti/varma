> check("compiled likelihood candidates preserve higher-order coefficient conventions",{
+   set.seed(781);m<-2L;p<-2L;q<-2L
+   A<-array(rnorm(8,sd=.05),c(m,m,p));A[,,1]<-A[,,1]+diag(.3,m)
+   B<-array(rnorm(8,sd=.05),c(m,m,q));S<-matrix(c(1,.25,.25,2),m)
+   mu<-c(2,-3);ch<-chol(S);diag(ch)<-log(diag(ch))
+   par<-c(mu,as.numeric(aperm(A,c(1,3,2))),as.numeric(aperm(B,c(1,3,2))),ch[upper.tri(ch,TRUE)])
+   z<-internal("varma_candidate_cpp")(par,m,p,q,TRUE)
+   stopifnot(z$valid);close(z$ar,A);close(z$ma,B);close(z$Q,S);close(z$mean,mu)
+   f<-varma(ar=A,ma=B,cov=S,mean=mu);ss<-varma_to_ss(f)
+   close(z$T,ss$T);close(z$R,ss$R)
+   d<-nrow(ss$T);W<-ss$R%*%S%*%t(ss$R)
+   reference_P<-matrix(solve(diag(d*d)-kronecker(ss$T,ss$T),as.numeric(W)),d,d)
+   close(z$P,reference_P)
+   Y<-sim_varma(f,100)
+   # An independent KFAS construction checks the scalar compiled objective.
+   SSMcustom<-KFAS::SSMcustom
+   ref<-KFAS::SSModel(sweep(Y,2,mu,"-")~0+SSMcustom(Z=ss$Z,T=ss$T,R=ss$R,Q=S,
+     P1=reference_P,P1inf=matrix(0,d,d),a1=numeric(d),index=seq_len(m)),H=matrix(0,m,m))
+   close(internal("varma_loglik_cpp")(par,t(Y),p,q,TRUE),as.numeric(logLik(ref)),1e-8)
+   X<-cbind(1,Y[,1],Y[,1])
+   reg<-internal(".varma_regression")(X,Y)
+   close(reg$residuals,Y-X%*%reg$coefficients)
+ })
PASS: compiled likelihood candidates preserve higher-order coefficient conventions 
