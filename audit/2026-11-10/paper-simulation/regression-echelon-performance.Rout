> close <- function(a,b,tol=1e-7) stopifnot(isTRUE(all.equal(as.numeric(a),as.numeric(b),tolerance=tol)))
> check <- function(name,expr) {force(expr);cat("PASS:",name,"\n")}
> fails <- function(expr) stopifnot(inherits(tryCatch({force(expr);NULL},error=identity),"error"))
> fixture_path <- if(file.exists("fixtures/kronid-reference.rds")) "fixtures/kronid-reference.rds" else "tests/fixtures/kronid-reference.rds"
> mts_reference <- readRDS(fixture_path)
