> check("dense Lyapunov methods agree with an independent Kronecker solve",{
+   set.seed(188)
+   for(d in c(1L,3L,8L,18L)) {
+     TT<-matrix(rnorm(d*d,sd=.1),d);TT<-TT/max(1,1.5*max(Mod(eigen(TT)$values)))
+     TT<-TT+diag(.15,d)
+     CC<-crossprod(matrix(rnorm(d*d),d))
+     ref<-matrix(solve(diag(d*d)-kronecker(TT,TT),as.numeric(CC)),d,d)
+     for(method in c("auto","doubling","schur")) {
+       pp<-solve_discrete_lyapunov(TT,CC,method)
+       close(pp,ref,1e-8);close(pp,TT%*%pp%*%t(TT)+CC,1e-9)
+     }
+   }
+   for(root in c(.9999,-.9999)) for(method in c("doubling","schur"))
+     close(solve_discrete_lyapunov(matrix(root),matrix(1),method),1/(1-root^2),1e-8)
+   fails(solve_discrete_lyapunov(diag(c(.5,1.01)),diag(2)))
+   fails(solve_discrete_lyapunov(diag(2)*.4,matrix(1:4,2)))
+ })
PASS: dense Lyapunov methods agree with an independent Kronecker solve 
