> check("echelon patterns preserve output order and agree with MTS specification",{
+     # Stored numerical references require no MTS installation.
+     for(fixture in mts_reference$patterns) {
+       indices <- fixture$indices
+       m<-length(indices);q<-max(indices)
+       pat<-internal(".varma_echelon_pattern")(indices,FALSE)
+       ar<-ma<-matrix(0L,m,m*(q+1L));ar[,seq_len(m)]<-ma[,seq_len(m)]<-diag(m)
+       for(j in seq_len(nrow(pat))) {
+         type<-pat[j,1];i<-pat[j,2]+1L;v<-pat[j,3]+1L;lag<-pat[j,4]
+         if(type==1L) {ar[i,v]<-2L;ma[i,v]<-2L}
+         if(type==2L) ar[i,m*lag+v]<-2L
+         if(type==3L) ma[i,m*lag+v]<-2L
+       }
+       spec<-fixture$spec
+       close(ar,spec$PhiID);close(ma,spec$ThetaID)
+     }
+ })
PASS: echelon patterns preserve output order and agree with MTS specification 
