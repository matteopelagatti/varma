> check("optimized GLS equals direct time-by-time GLS, including p=0",{
+   set.seed(91);Y<-matrix(rnorm(360),120,3);U<-matrix(rnorm(360),120,3)
+   W<-solve(matrix(c(2,.2,.3,.2,1,.1,.3,.1,1.5),3))
+   for(p in c(0L,2L)) for(type in c("diagonal","final")) {
+     q<-2L;m<-3L;nphi<-m*m*p;k<-nphi+if(type=="diagonal") m*q else q
+     lhs<-matrix(0,k,k);rhs<-numeric(k)
+     for(t in seq.int(max(p,q)+1L,nrow(Y))) {
+       Z<-matrix(0,m,k)
+       for(i in seq_len(m)) {
+         if(p) Z[i,(i-1L)*m*p+seq_len(m*p)]<-as.numeric(t(Y[t-seq_len(p),,drop=FALSE]))
+         ix<-nphi+if(type=="diagonal") (i-1L)*q+seq_len(q) else seq_len(q)
+         Z[i,ix]<-U[t-seq_len(q),i]
+       }
+       lhs<-lhs+t(Z)%*%W%*%Z;rhs<-rhs+as.numeric(t(Z)%*%W%*%Y[t,])
+     }
+     got<-internal("estimate_varma_gls_cpp")(Y,U,W,p,q,type)
+     close(got$A_matrix,lhs);close(got$coefficients,solve(lhs,rhs))
+   }
+ })
PASS: optimized GLS equals direct time-by-time GLS, including p=0 
